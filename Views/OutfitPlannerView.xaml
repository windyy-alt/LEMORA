<UserControl x:Class="LEMORA.Views.OutfitPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,25,28,30">
            <!-- Page header -->
            <Grid Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Outfit Planner"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Schedule your saved outfits for upcoming activities."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,0" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Today"
                        Command="{Binding TodayCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <!-- Calendar -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="‹"
                                        FontSize="20" Width="35" Height="35" Padding="0"
                                        Command="{Binding PreviousMonthCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding VisibleMonthLabel, Mode=OneWay}"
                                           Style="{StaticResource SectionTitleStyle}"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="›"
                                        FontSize="20" Width="35" Height="35" Padding="0"
                                        Command="{Binding NextMonthCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding WeekDays}" Margin="0,0,0,7">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Margin="0,0,4,4"
                                                Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{Binding CellBackground}"
                                                    HorizontalAlignment="Stretch"
                                                    CornerRadius="9" Height="69" Padding="6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding DayNumber}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding DayForeground}"/>
                                                        <TextBlock Text="{Binding PlanMarker}" DockPanel.Dock="Right"
                                                                   HorizontalAlignment="Right" FontSize="11"
                                                                   Foreground="{Binding MarkerColor}"/>
                                                    </DockPanel>
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding TodayLabel}" FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding DayForeground}"/>
                                                        <TextBlock Text="{Binding ActivityLabel}" FontSize="9"
                                                                   Foreground="{Binding DayForeground}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="28" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Upcoming schedule -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,15,0,0" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,11">
                                <TextBlock Text="Upcoming Schedule" DockPanel.Dock="Left"
                                           Style="{StaticResource SectionTitleStyle}" FontSize="17"/>
                                <TextBlock Text="{Binding UpcomingCount, Mode=OneWay}"
                                           DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock Text="No upcoming outfits. Choose a day to make a plan."
                                       Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"
                                       Visibility="{Binding HasNoUpcoming, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding UpcomingPlans}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="156" Margin="0,0,8,8" Padding="0"
                                                Background="Transparent"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding DataContext.SelectUpcomingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="9"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10"
                                                    MinHeight="100">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Date, StringFormat={}{0:ddd MMM d}}"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               FontWeight="Bold" FontSize="10"/>
                                                    <TextBlock Text="{Binding Activity}" FontFamily="Georgia"
                                                               FontSize="15" FontWeight="Bold"
                                                               Margin="0,6,0,3" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Outfit.Name}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Planning panel -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SCHEDULED DATE" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding SelectedDateLabel, Mode=OneWay}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   FontSize="19" Margin="0,7,0,15" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource PreviewBrush}" CornerRadius="10" Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ASSIGNED OUTFIT" FontWeight="Bold" FontSize="10"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding ScheduledOutfitName, Mode=OneWay}"
                                           FontFamily="Georgia" FontSize="17" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding ScheduledActivity, Mode=OneWay}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding SelectedPreviewItems}"
                                              Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBrush}" CornerRadius="7"
                                                    Margin="0,0,7,7" Padding="5">
                                                <StackPanel>
                                                    <Border Height="78" Background="{DynamicResource SlotBrush}"
                                                            CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding ClothingItem.ImagePath}"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Slot}" FontSize="9"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding ClothingItem.Name}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PLAN OR EDIT THIS DAY" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Outfit" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,11,0,6"/>
                        <ComboBox ItemsSource="{Binding SavedOutfits}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedOutfit, Mode=TwoWay}"
                                  Padding="8,8" FontSize="12"/>
                        <TextBlock Text="Create an outfit in Outfit Studio first."
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoSavedOutfits, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="Activity" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,13,0,6"/>
                        <TextBox Text="{Binding Activity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" MaxLength="100"/>

                        <TextBlock Text="Notes (optional)" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,13,0,6"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" MaxLength="300"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="58"/>

                        <Button Content="{Binding SaveButtonLabel, Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SavePlanCommand}"
                                Margin="0,17,0,6"/>
                        <Button Content="Remove from Calendar" Background="{DynamicResource MelonBrush}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RemovePlan_Click"
                                Visibility="{Binding HasSelectedPlan, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Feedback}" Margin="0,12,0,0"
                                   FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
