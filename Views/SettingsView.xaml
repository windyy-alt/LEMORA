<UserControl x:Class="LEMORA.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">
            <TextBlock Text="Settings &amp; Appearance"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Personalize your Lemora workspace and view local storage information."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,5,0,24" FontSize="13"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"/>
                    <ColumnDefinition Width="9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,16,0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Application Appearance &amp; Themes"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Choose a look for your personal digital wardrobe."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,6,0,16"/>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="10" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="☀  Light Mode" Click="LightMode_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="☾  Dark Mode"
                                        Click="DarkMode_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ThemeStatusText" FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,13"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Background="{DynamicResource ElevatedBrush}"
                                    Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Pastel Atelier" FontFamily="Georgia"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Light" Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,10"/>
                                    <Border Height="93" Background="#EDECDB"
                                            CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <Border Width="65" Height="12" HorizontalAlignment="Left"
                                                    Background="#6BB1AD" CornerRadius="5"/>
                                            <Border Height="44" Background="#FFFFFF" CornerRadius="6"
                                                    Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Soft, airy and editorial"
                                               Margin="0,8,0,0" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource ElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Charcoal Velvet" FontFamily="Georgia"
                                               FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Dark" Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,10"/>
                                    <Border Height="93" Background="#19272B"
                                            CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <Border Width="65" Height="12" HorizontalAlignment="Left"
                                                    Background="#356D6B" CornerRadius="5"/>
                                            <Border Height="44" Background="#233238" CornerRadius="6"
                                                    Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Calm, refined and low-glare"
                                               Margin="0,8,0,0" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="10"
                                Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Your palette"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Veranda Blue · Sky Cloud · Lychee · Melon · Cupid Pink"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FeedbackText" FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Local SQLite Storage"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Your wardrobe is stored locally on this computer."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" Margin="0,6,0,15"/>
                            <TextBlock Text="DATABASE FILE" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                    Padding="10" Margin="0,5,0,14">
                                <TextBlock x:Name="DatabasePathText" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceBrush}" Padding="12"
                                        CornerRadius="8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="ClothingCountText" FontFamily="Georgia"
                                                   FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="Clothing items"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="OutfitCountText" FontFamily="Georgia"
                                                   FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="Saved outfits"
                                                   Style="{StaticResource MutedTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="StorageInfoText" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <Button Content="Open Data Folder" Click="OpenDataFolder_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="About Lemora"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Your Wardrobe, Your Aura."
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontWeight="SemiBold" Margin="0,6,0,14"/>
                            <TextBlock Text="A personal wardrobe desktop application for organizing clothing, building outfits, planning looks and discovering combinations."
                                       TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="Windows · WPF · C# · MVVM · SQLite"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,15,0,0"/>
                            <TextBlock Text="All wardrobe data stays on this device unless you copy or share it."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
