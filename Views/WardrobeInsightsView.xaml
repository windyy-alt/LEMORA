<UserControl x:Class="LEMORA.Views.WardrobeInsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Wardrobe Insights"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="A closer look at your wardrobe, based on your saved clothing and outfits."
                               FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Insights"
                        Click="Refresh_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                       Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="12" Padding="18"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,18"
                    Visibility="{Binding IsWardrobeEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Your collection is waiting to be explored"
                               FontFamily="Georgia" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Add clothing in My Closet to see category and color insights here."
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Summary cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" MinHeight="126">
                    <StackPanel>
                        <TextBlock Text="TOTAL GARMENTS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalGarments, Mode=OneWay}"
                                   FontFamily="Georgia" FontWeight="Bold" FontSize="34"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,11,0,4"/>
                        <TextBlock Text="pieces in your closet" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" MinHeight="126">
                    <StackPanel>
                        <TextBlock Text="SAVED OUTFITS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding SavedOutfits, Mode=OneWay}"
                                   FontFamily="Georgia" FontWeight="Bold" FontSize="34"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,11,0,4"/>
                        <TextBlock Text="looks you have created" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" MinHeight="126">
                    <StackPanel>
                        <TextBlock Text="FAVORITE ITEMS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding FavoriteItems, Mode=OneWay}"
                                   FontFamily="Georgia" FontWeight="Bold" FontSize="34"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,11,0,4"/>
                        <TextBlock Text="marked as favorite" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" MinHeight="126">
                    <StackPanel>
                        <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalCategories, Mode=OneWay}"
                                   FontFamily="Georgia" FontWeight="Bold" FontSize="34"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,11,0,4"/>
                        <TextBlock Text="represented in closet" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,16,0" MinHeight="370">
                    <StackPanel>
                        <TextBlock Text="Clothing Category Distribution"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="How your items are divided across categories"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,5,0,10"/>

                        <Grid Width="210" Height="210" HorizontalAlignment="Center"
                              Margin="0,3,0,8"
                              Visibility="{Binding HasWardrobe, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl Width="200" Height="200"
                                          ItemsSource="{Binding Categories}"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding DonutGeometry}"
                                              Fill="{Binding Swatch}"
                                              Stretch="None" Width="200" Height="200"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalGarments, Mode=OneWay}"
                                           FontFamily="Georgia" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="garments" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="10" Height="10" CornerRadius="3"
                                                Background="{Binding Swatch}" VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                   FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="370">
                    <StackPanel>
                        <TextBlock Text="Color Palette Breakdown"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Most common color labels from My Closet"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,5,0,20"/>

                        <TextBlock Text="No color data available yet."
                                   Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding IsWardrobeEmpty, Converter={StaticResource BoolToVisibility}}"/>

                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,17">
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="13" Height="13" CornerRadius="4"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Background="{Binding Swatch}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                       HorizontalAlignment="Right" FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Height="11"
                                                     Value="{Binding Percentage}" Foreground="{Binding Swatch}"
                                                     Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Swatch colors are approximate representations of color names."
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detailed overview -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="Garments per Category"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Counts and percentages of your collection"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,5,0,18"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                     Height="12" VerticalAlignment="Center"
                                                     Background="{DynamicResource SurfaceBrush}" Foreground="{Binding Swatch}"
                                                     BorderThickness="0" Value="{Binding Percentage}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="10"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Your Wardrobe at a Glance"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="A summary based on stored items"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,5,0,18"/>

                        <TextBlock Text="LARGEST CATEGORY" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding LargestCategory}" FontFamily="Georgia"
                                   FontSize="22" FontWeight="Bold" Margin="0,5,0,3"/>
                        <TextBlock Text="{Binding LargestCategoryDetail}"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="MOST COMMON COLOR" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding PopularColor}" FontFamily="Georgia"
                                           FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOP-TO-BOTTOM RATIO" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding TopBottomRatio}" FontFamily="Georgia"
                                           FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource PreviewBrush}" CornerRadius="10"
                                Padding="13" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="COLLECTION NOTE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding WardrobeObservation}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
