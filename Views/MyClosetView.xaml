<UserControl x:Class="LEMORA.Views.MyClosetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30,26,30,30">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="My Closet"
                               Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="13">
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" pieces in your personal collection"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Add Clothing"
                        Command="{Binding OpenFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Search and Filter -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,24,0,20">

                <StackPanel>
                    <TextBlock Text="Explore Your Wardrobe"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,0"
                                 ToolTip="Search clothing by name, brand, or color"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Padding="10,7"
                                  FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Add Clothing Form -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,20"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

                <StackPanel>
                    <TextBlock Text="Add New Clothing"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Add a new piece to your digital wardrobe."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Item Name *"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>

                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Category"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>

                            <ComboBox Padding="9,7"
                                      SelectedItem="{Binding NewCategory}">
                                <ComboBoxItem Content="Tops"/>
                                <ComboBoxItem Content="Bottoms"/>
                                <ComboBoxItem Content="Outerwear"/>
                                <ComboBoxItem Content="Dresses"/>
                                <ComboBoxItem Content="Shoes"/>
                                <ComboBoxItem Content="Accessories"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Color"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>

                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding NewColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">

                        <Button Content="Cancel"
                                Command="{Binding CancelFormCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Content="Save Clothing"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Feedback}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,12"/>

            <!-- Empty State -->
            <Border Style="{StaticResource CardStyle}"
                    MinHeight="240"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="✦"
                               FontSize="38"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Your wardrobe is waiting!"
                               FontFamily="Georgia"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,6"/>

                    <TextBlock Text="Add your first clothing item or adjust your filters."
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Clothing Cards -->
            <ItemsControl ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="210"
                                Margin="0,0,14,14"
                                Background="White"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">

                            <StackPanel>
                                <Border Height="165"
                                        Background="#F3F1E7">

                                    <Grid>
                                        <TextBlock Text="LEMORA"
                                                   FontFamily="Georgia"
                                                   FontSize="19"
                                                   FontStyle="Italic"
                                                   Foreground="#A7BCBD"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Image Source="{Binding ImagePath}"
                                               Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="14">
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="Georgia"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,7,0,5"/>

                                    <TextBlock Text="{Binding ColorName}"
                                               Style="{StaticResource MutedTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
