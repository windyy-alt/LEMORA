<UserControl x:Class="LEMORA.Views.StyleSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30">

            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Find Your Perfect Look"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Rule-based outfit ideas, created from your own wardrobe."
                               FontSize="13" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12" Padding="18,11"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="YOUR COLLECTION  " FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding WardrobeCount, Mode=OneWay}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text=" pieces" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="TARGET OCCASION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Occasions}"
                                  SelectedItem="{Binding SelectedOccasion, Mode=TwoWay}"
                                  Padding="10,7" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="COLOR PREFERENCE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ColorPreferences}"
                                  SelectedItem="{Binding SelectedColorPreference, Mode=TwoWay}"
                                  Padding="10,7" FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Generate Suggestions"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom" MinHeight="36"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Feedback, Mode=OneWay}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="2,0,0,16"/>

            <Grid Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Curated from Your Closet" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding ResultSummary, Mode=OneWay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="14"
                                        Margin="0,0,14,0">
                                    <StackPanel>
                                        <Border Background="{DynamicResource SlotBrush}" CornerRadius="10"
                                                Padding="8,5" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Occasion}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="Georgia" FontSize="22"
                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,10,0,4"/>
                                        <TextBlock Text="{Binding ItemSummary}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,0,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Pieces}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource HeaderBrush}" Margin="0,0,7,8"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="9" ClipToBounds="True">
                                                        <StackPanel>
                                                            <Border Background="{DynamicResource SurfaceBrush}" Height="116">
                                                                <Image Source="{Binding Clothing.ImagePath}"
                                                                       Stretch="Uniform" Margin="4"/>
                                                            </Border>
                                                            <StackPanel Margin="8,6,8,8">
                                                                <TextBlock Text="{Binding Slot}"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           FontSize="10" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Clothing.Name}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Clothing.Name}"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="{DynamicResource PreviewBrush}" CornerRadius="9"
                                                Padding="12" Margin="0,10,0,12" MinHeight="83">
                                            <StackPanel>
                                                <TextBlock Text="WHY THIS LOOK WORKS"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="Save Outfit"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.SaveSuggestionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanSave}"
                                                HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Saved to Outfit Studio"
                                                   Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   TextAlignment="Center" FontSize="11"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="25"
                    MinHeight="180"
                    Visibility="{Binding HasNoSuggestions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontFamily="Georgia" FontSize="35"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your next look starts here"
                               FontFamily="Georgia" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,9,0,6"/>
                    <TextBlock Text="Choose your preferences and generate outfit ideas from My Closet."
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="How Lemora Creates Suggestions"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                    <TextBlock Text="01  Clothing categories form valid outfits: a dress, or a top with a bottom."
                               FontSize="12" Margin="0,0,0,7" TextWrapping="Wrap"/>
                    <TextBlock Text="02  Occasion tags, when provided, help prioritize matching pieces."
                               FontSize="12" Margin="0,0,0,7" TextWrapping="Wrap"/>
                    <TextBlock Text="03  Color names guide simple palette matching. No AI or internet connection required."
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
