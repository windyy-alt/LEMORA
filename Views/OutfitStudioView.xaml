<UserControl x:Class="LEMORA.Views.OutfitStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,23,26,26">
            <DockPanel Margin="0,0,0,17">
                <Button Content="+ New Outfit" DockPanel.Dock="Right"
                        Command="{Binding NewOutfitCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="Outfit Studio"
                               Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="Mix and match pieces from your own wardrobe."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource PrimaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="223"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="263"/>
                </Grid.ColumnDefinitions>

                <!-- Wardrobe drawer -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        Padding="12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Wardrobe Drawer"
                                   Style="{StaticResource SectionTitleStyle}"
                                   FontSize="16"/>
                        <TextBlock Text="Choose clothing to fill a slot"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,12"/>
                        <TextBlock Text="Search clothes" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10"/>
                        <ComboBox ItemsSource="{Binding ClothingCategories}"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Padding="7,5" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10"
                                Visibility="{Binding IsWardrobeEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Your wardrobe is empty. Add clothes in My Closet first."
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer Height="495" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredClothes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="9"
                                                Padding="6" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="56" Background="{DynamicResource SlotBrush}"
                                                        CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    <Button Content="+ Select" FontSize="10" Padding="7,4"
                                                            Margin="0,4,0,0" HorizontalAlignment="Right"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding DataContext.SelectClothingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Flat-lay preview -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                        Padding="14" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Outfit Lookbook" DockPanel.Dock="Left"
                                       Style="{StaticResource SectionTitleStyle}" FontSize="17"/>
                        </DockPanel>
                        <TextBlock Text="Select items on the left to build a coordinated look."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"
                                   TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding PreviewSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Margin="0,0,8,8" Padding="8" Height="172">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <Button Content="×" DockPanel.Dock="Right"
                                                        FontSize="14" Width="22" Height="22"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Padding="0"
                                                        Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Label}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </DockPanel>
                                            <Grid Grid.Row="1" Margin="0,3,0,4">
                                                <TextBlock Text="Choose an item" FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                                <Image Source="{Binding ImagePath}" Stretch="Uniform"
                                                       MaxHeight="112"/>
                                            </Grid>
                                            <TextBlock Grid.Row="2" Text="{Binding DisplayName}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource SoftAccentBrush}" CornerRadius="8" Padding="11"
                                Margin="0,7,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}">
                                <Run Text="Selected pieces: "/>
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text="  •  Click any item to replace its slot."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Outfit configuration -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Outfit Configuration"
                                   Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,5,0,14"/>

                        <TextBlock Text="OUTFIT NAME" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding OutfitName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,14" MaxLength="100"/>

                        <TextBlock Text="OCCASION" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <ComboBox ItemsSource="{Binding Occasions}"
                                  SelectedItem="{Binding SelectedOccasion, Mode=TwoWay}"
                                  Padding="7,7" Margin="0,5,0,14"/>

                        <TextBlock Text="SELECTED CLOTHING" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <ItemsControl ItemsSource="{Binding PreviewSlots}" Margin="0,6,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding SaveButtonText}" Command="{Binding SaveOutfitCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8"/>
                        <Button Content="Clear / New Outfit" Command="{Binding NewOutfitCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,20"/>

                        <TextBlock Text="Saved Outfits" Style="{StaticResource SectionTitleStyle}"
                                   FontSize="16" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SavedOutfits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="9" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Occasion}" FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Open / Edit" FontSize="10" Padding="8,5"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenSavedOutfitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                                <Button Content="Delete" FontSize="10" Padding="8,5"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="DeleteSavedOutfit_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
